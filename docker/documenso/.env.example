# =============================================================================
# Documenso (self-hosted document signing) Environment Variables
# =============================================================================
# Copy this file to `.env` in this directory:
#   cp .env.example .env
# `docker compose` automatically reads `.env` from the directory holding
# `docker-compose.yml`, and every value below is interpolated into
# `docker-compose.yml`.
#
# This stack is only needed when the signing module is on
# (IS_SIGNING_PACKAGE_ENABLED / NEXT_PUBLIC_IS_SIGNING_PACKAGE_ENABLED = true).
# Start it with `docker compose up -d` from this directory, then point
# apps/server's DOCUMENSO_API_URL at it.
#
# These are Documenso's own variables, not TurboPlan's — no TurboPlan code
# reads them. The "if unset" notes below therefore describe the upstream
# `documenso/documenso` image's documented behaviour plus what compose does
# with an empty value; they are not verifiable from this repository. See
# CONFIGURATION.md at the repo root for the TurboPlan side
# (DOCUMENSO_API_URL / DOCUMENSO_API_KEY / DOCUMENSO_WEBHOOK_SECRET).
# =============================================================================

# =============================================================================
# POSTGRES (Documenso's own database container)
# =============================================================================

# Postgres role Documenso connects as.
# REQUIRED — compose interpolates it into the connection string.
# If unset: compose warns about an empty variable and the database container
# fails its `pg_isready` healthcheck, so the documenso service never starts.
POSTGRES_USER=documenso

# Password for that role.
# REQUIRED. Any value works — this database is local to the compose stack.
# If unset: same failure as POSTGRES_USER (empty password in the DSN).
# Generate using: openssl rand -base64 24
POSTGRES_PASSWORD=change-me-strong-password

# Database name created on first boot.
# REQUIRED.
# If unset: the interpolated DSN names no database, so Documenso's startup
# migrations fail.
POSTGRES_DB=documenso

# =============================================================================
# APP SECRETS
# =============================================================================
# Generate each of the three with: openssl rand -base64 32
# These are Documenso-internal; they are unrelated to TurboPlan's AUTH_SECRET /
# ENCRYPTION_KEY and must NOT be set to the same values.

# Documenso's NextAuth session secret.
# REQUIRED (per Documenso's self-hosting docs).
# If unset: compose passes an empty value and Documenso cannot sign sessions —
# login to the Documenso UI fails.
NEXTAUTH_SECRET=

# Primary key Documenso uses to encrypt its own secrets at rest.
# REQUIRED (per Documenso's self-hosting docs).
# If unset: compose passes an empty value and Documenso cannot start cleanly.
# Rotating it makes previously encrypted Documenso data unreadable.
NEXT_PRIVATE_ENCRYPTION_KEY=

# Secondary encryption key (used by Documenso for key rotation).
# REQUIRED (per Documenso's self-hosting docs).
# If unset: compose passes an empty value and Documenso cannot start cleanly.
NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY=

# =============================================================================
# URLS AND PORTS
# =============================================================================

# Public URL where Documenso is reachable from your browser. Also the value you
# put in apps/server's DOCUMENSO_API_URL.
# REQUIRED.
# If unset: signing links and emails are generated with a broken base URL.
# Local value: http://localhost:3004
NEXT_PUBLIC_WEBAPP_URL=http://localhost:3004

# Host port mapped to Documenso's in-container port 3000.
# OPTIONAL — defaults to 3004 via `${DOCUMENSO_PORT:-3004}` in compose.
# Keep it off 3000/3001/3002, which the web app, API and landing page use.
DOCUMENSO_PORT=3004

# =============================================================================
# SMTP (outgoing signing emails)
# =============================================================================

# Transport Documenso uses to send mail.
# REQUIRED for signing emails to leave the container.
# If unset: compose passes an empty transport and Documenso cannot send the
# signature-request emails — the signing flow stalls after document creation.
# Use `smtp-auth` for a normal authenticated SMTP server.
NEXT_PRIVATE_SMTP_TRANSPORT=smtp-auth

# SMTP server hostname.
# REQUIRED when NEXT_PRIVATE_SMTP_TRANSPORT=smtp-auth.
# If unset: mail sending throws and signature-request emails are never sent.
NEXT_PRIVATE_SMTP_HOST=smtp.example.com

# SMTP server port.
# REQUIRED when NEXT_PRIVATE_SMTP_TRANSPORT=smtp-auth. 587 for STARTTLS.
# If unset: the connection is attempted on no port and fails.
NEXT_PRIVATE_SMTP_PORT=587

# SMTP username.
# REQUIRED when NEXT_PRIVATE_SMTP_TRANSPORT=smtp-auth.
# If unset: the SMTP server rejects the session with an auth error.
# For local testing, an https://ethereal.email/create account works.
NEXT_PRIVATE_SMTP_USERNAME=

# SMTP password.
# REQUIRED when NEXT_PRIVATE_SMTP_TRANSPORT=smtp-auth.
# If unset: same auth failure as NEXT_PRIVATE_SMTP_USERNAME.
NEXT_PRIVATE_SMTP_PASSWORD=

# Display name on outgoing signing emails.
# OPTIONAL — cosmetic; recipients see an empty sender name when unset.
NEXT_PRIVATE_SMTP_FROM_NAME=TurboPlan Signing

# From address on outgoing signing emails.
# REQUIRED when NEXT_PRIVATE_SMTP_TRANSPORT=smtp-auth.
# If unset: most SMTP servers reject the message for a missing envelope sender.
NEXT_PRIVATE_SMTP_FROM_ADDRESS=signing@example.com

# =============================================================================
# SIGNING CERTIFICATE
# =============================================================================

# Password of the PKCS#12 signing certificate mounted at /opt/documenso/cert.p12.
# REQUIRED.
# If unset or wrong: Documenso cannot open the certificate, so sealing a
# completed document fails and the signed PDF is never produced.
# Create the certificate with `./generate-cert.sh` in this directory — it prints
# the password to put here.
NEXT_PRIVATE_SIGNING_PASSPHRASE=
