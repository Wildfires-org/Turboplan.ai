# =============================================================================
# TurboPlan Web Application Environment Variables
# =============================================================================
# Copy this file to `.env.local` in this directory:
#   cp .env.example .env.local
# `.env.local` (not `.env`) is the required name: Next.js reads it, and the
# database scripts (`pnpm db:push`, `db:migrate`, `db:studio`, `drizzle.config.ts`)
# load `.env.local` by an explicit hardcoded path.
#
# Env access goes through getWebEnv() in @wildfires-org/turboplan-env. Missing
# REQUIRED values throw on the first render that touches env, which in practice
# means the app fails to serve any page.
#
# Note: `pnpm db:push` also needs the workspace packages built first — run
# `pnpm build:packages` from the repo root before any db:* script.
#
# For the cross-cutting picture — which file each app reads, the four auth
# secrets, the minimum local setup, feature flags and deployment — see
# CONFIGURATION.md at the repo root.
# =============================================================================

# =============================================================================
# ENVIRONMENT
# =============================================================================

# Deploy target: production / develop / pr_preview. LEAVE UNSET LOCALLY — the
# deploy pipeline sets it.
# OPTIONAL.
# If unset (and NODE_ENV is not "production"): isLocalDevelopment() is true, so
# the dev-only prompt debug routes under /api/debug are reachable. Setting it to
# any of the three deployed values makes those routes 404. It is also the
# Sentry "environment" tag.
APP_ENV=

# =============================================================================
# DATABASE
# =============================================================================

# PostgreSQL connection URL. Format: postgresql://user:password@host:port/database
# REQUIRED.
# If unset: startup throws "Missing database URL: set `POSTGRES_URL` or
# `TEST_POSTGRES_URL` env variable".
# Must point at the same database as the API server's POSTGRES_URL.
POSTGRES_URL=postgresql://user:password@localhost:5432/turboplan

# =============================================================================
# AUTHENTICATION
# =============================================================================
# Three of the four shared secrets live here (ENCRYPTION_KEY is API-server only).
# Generate each one separately — reusing a single value for all of them defeats
# the point of the split. See CONFIGURATION.md.

# Secret for the NextAuth session cookie (JWE) and the analytics email HMAC seed.
# REQUIRED (server-side only; never reaches the browser bundle).
# If unset: startup throws "Missing `AUTH_SECRET` env variable" — no page renders.
# Generate using: openssl rand -base64 32
# Must be byte-identical to AUTH_SECRET in apps/server and apps/landing-page.
AUTH_SECRET=change-me

# Shared secret sent as the `X-Internal-Secret` header on the internal
# magic-link email call to the API server.
# REQUIRED (server-side only).
# If unset: startup throws "Missing `INTERNAL_API_SECRET` env variable (required
# for internal API calls)". If it does not match the API server's, the email
# endpoint returns 401 and login silently fails.
# Generate using: openssl rand -base64 32
# Must be byte-identical to INTERNAL_API_SECRET in apps/server.
INTERNAL_API_SECRET=change-me

# HS256 key used to mint the API tokens the server verifies.
# REQUIRED (server-side only).
# If unset: startup throws "Missing `JWT_SIGNING_SECRET` env variable (required
# for API token signing)". If it does not match the API server's, every
# authenticated API call comes back 401.
# Generate using: openssl rand -base64 32
# Must be byte-identical to JWT_SIGNING_SECRET in apps/server.
JWT_SIGNING_SECRET=change-me

# Cookie domain for cross-subdomain session sharing with the landing page.
# OPTIONAL.
# If unset: the `domain` attribute is omitted and the session cookie is
# host-only, so the landing page cannot see the app's session. Leave empty for
# local development.
# Example: .yourdomain.com (leading dot)
AUTH_COOKIE_DOMAIN=

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# NEXT_PUBLIC_ so the browser bundle can read them. Only the literal string
# "true" (any case) enables a module — "1" and "yes" do NOT. Four of them
# (TASKS, MAPS, PROJECT_CONTEXT, RESEARCH_AGENT_INTEGRATION) are presence-checked
# at startup: they must be set to something, even "false", or the app throws. The
# rest default to off when absent. Every value must match the corresponding IS_*
# variable in apps/server, or the UI offers features the API refuses to serve.
#
# Defaults below turn on everything that works with no extra setup. MAPS,
# RESEARCH_AGENT_INTEGRATION, SIGNING and BILLING stay "false" because enabling
# any of them makes further variables required and the API server throws at
# startup without them — see each entry.

# Tasks and milestones module.
# REQUIRED to be present (value "true" or "false").
# If unset: startup throws "Missing `IS_TASKS_PACKAGE_ENABLED` or
# `NEXT_PUBLIC_IS_TASKS_PACKAGE_ENABLED` env variable".
NEXT_PUBLIC_IS_TASKS_PACKAGE_ENABLED=true

# Custom project fields module.
# OPTIONAL — defaults to off when absent (not presence-checked).
# If unset: the custom-fields UI is hidden.
NEXT_PUBLIC_IS_FIELDS_PACKAGE_ENABLED=true

# Interactive maps module.
# REQUIRED to be present (value "true" or "false").
# If unset: startup throws "Missing `IS_MAPS_PACKAGE_ENABLED` or
# `NEXT_PUBLIC_IS_MAPS_PACKAGE_ENABLED` env variable".
# Turning it on also requires MAP_SERVICE_* on the API server and a running
# Python map service.
NEXT_PUBLIC_IS_MAPS_PACKAGE_ENABLED=false

# Project document uploads module (PDF, Word).
# OPTIONAL — defaults to off when absent (not presence-checked).
# If unset: the document upload UI is hidden. Turning it on needs working R2
# credentials or every upload fails.
NEXT_PUBLIC_IS_DOCUMENTS_PACKAGE_ENABLED=true

# Project timeline / activity log module.
# OPTIONAL — defaults to off when absent (not presence-checked).
# If unset: the timeline tab is hidden.
NEXT_PUBLIC_IS_TIMELINE_RECORDS_PACKAGE_ENABLED=true

# Project context module.
# REQUIRED to be present (value "true" or "false").
# If unset: startup throws "Missing `IS_PROJECT_CONTEXT_PACKAGE_ENABLED` or the
# NEXT_PUBLIC_ variant".
NEXT_PUBLIC_IS_PROJECT_CONTEXT_PACKAGE_ENABLED=true

# Research agent integration module.
# REQUIRED to be present (value "true" or "false").
# If unset: startup throws "Missing
# `IS_RESEARCH_AGENT_INTEGRATION_PACKAGE_ENABLED` or the NEXT_PUBLIC_ variant".
# Turning it on also requires RESEARCH_AGENT_SERVICE_* on the API server and a
# running apps/research-agent.
NEXT_PUBLIC_IS_RESEARCH_AGENT_INTEGRATION_PACKAGE_ENABLED=false

# Document signing module (Documenso). Credentials live on the API server only;
# the browser just needs this flag.
# OPTIONAL — defaults to off when absent (not presence-checked).
# If unset: the signing UI is hidden. If "true" while the server's
# IS_SIGNING_PACKAGE_ENABLED is not, the signing routes 404.
NEXT_PUBLIC_IS_SIGNING_PACKAGE_ENABLED=false

# Stripe billing module. Stripe keys live on the API server only; the browser
# just needs this flag.
# OPTIONAL — defaults to off when absent (not presence-checked).
# If unset: /setup/plan is skipped and no paywall is shown. If "true" while the
# server's IS_BILLING_PACKAGE_ENABLED is not, checkout breaks at the API call.
NEXT_PUBLIC_IS_BILLING_PACKAGE_ENABLED=false

# =============================================================================
# AI PROVIDERS
# =============================================================================

# OpenRouter API key — the model provider for chat, titles, suggestions and
# image generation.
# REQUIRED for any AI feature (validated lazily, not at startup).
# If unset: pages render, but the first AI call throws "Missing
# `OPENROUTER_API_KEY` env variable" and that route returns 500.
# Get it from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key

# Primary language model — chat, reasoning, artifacts, auto-responder.
# OPTIONAL. Resolution order: database config (admin panel) -> this variable ->
# built-in default (anthropic/claude-sonnet-4.6).
OPENROUTER_MODEL_PRIMARY=

# Lightweight language model — titles, suggestions, prompt validation.
# OPTIONAL. Same resolution order; default anthropic/claude-haiku-4.5.
OPENROUTER_MODEL_LITE=

# Image model for user-triggered image generation.
# OPTIONAL. Same resolution order; default google/gemini-2.5-flash-image.
OPENROUTER_MODEL_IMAGE_PRIMARY=

# Image model for auto-generated project cover images.
# OPTIONAL. Same resolution order; default google/gemini-2.5-flash-image.
OPENROUTER_MODEL_IMAGE_LITE=

# Exa.ai API key — enables web search inside chat.
# OPTIONAL.
# If unset: search calls return an empty result set plus the warning
# "EXA_API_KEY is not configured. Web search is unavailable." Chat still works.
# Get it from: https://exa.ai
EXA_API_KEY=

# =============================================================================
# AI FEATURES
# =============================================================================

# Turns OFF automatic AI cover-image generation for new projects.
# OPTIONAL — only the literal "true" disables generation.
# If unset: new projects get an auto-generated cover, which costs an OpenRouter
# image call and needs working R2 credentials to store the result.
NEXT_PUBLIC_DISABLE_AUTO_PROJECT_IMAGE_GENERATION=false

# Load prompts from the database (admin panel) instead of the ones bundled in
# code.
# OPTIONAL, dev/test only — only the literal "true" enables it.
# If unset: the prompts compiled into @wildfires-org/turboplan-ai are used.
# Keep it identical to the API server's value, or the two disagree about which
# prompt text is live.
USE_EXTERNAL_PROMPTS=

# PIPE-separated (`|`, not comma) emails allowed into the admin panel.
# OPTIONAL.
# If unset: isSuperAdmin() is false for everyone and the admin routes 403.
# A comma-separated value silently matches nobody.
# Example: you@example.com|teammate@example.com
ADMIN_EMAILS=

# =============================================================================
# FILE STORAGE (Cloudflare R2)
# =============================================================================
# The first four are used only by the server-side profile-avatar action, which
# deletes the previous avatar from R2. They are validated together by
# getR2Env(), lazily — the app runs without them until that action fires, which
# then throws "Missing `R2_...` env variable".
# Create a bucket and an S3-compatible API token at:
#   Cloudflare Dashboard -> R2 -> Manage R2 API Tokens

# R2 access key ID (S3-compatible credential).
# REQUIRED for avatar replacement; everything else works without it.
R2_ACCESS_KEY_ID=your-r2-access-key-id

# R2 secret access key.
# REQUIRED for avatar replacement. If wrong: R2 returns a 403 signature error.
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Bucket name.
# REQUIRED for avatar replacement.
R2_BUCKET_NAME=your-bucket-name

# Cloudflare account ID that owns the bucket (Dashboard -> Overview, right
# sidebar) — it forms the S3 endpoint hostname.
# REQUIRED for avatar replacement.
R2_ACCOUNT_ID=your-cloudflare-account-id

# Public URL(s) of the R2 bucket(s) whose images this app renders. Read at BUILD
# time and baked into next/image `remotePatterns` — changing it needs a rebuild.
# REQUIRED for any R2-hosted image (cover images, avatars) to display.
# If unset: remotePatterns keeps only its non-R2 defaults, and every R2 image
# fails with "Invalid src prop ... hostname is not configured". Nothing throws.
# Accepts a comma-separated list when images span several buckets (this app's
# bucket plus the API server's image-generation bucket).
# Example: https://pub-xxxx.r2.dev,https://pub-yyyy.r2.dev
R2_PUBLIC_URL=

# =============================================================================
# BRANDING
# =============================================================================

# Application display name used in page titles, the sidebar wordmark and
# metadata.
# OPTIONAL (strongly recommended).
# If unset: every one of those surfaces renders the literal placeholder
# "[Your Brand]" — there is no guard that stops the build.
# Should match APP_NAME in apps/server and NEXT_PUBLIC_APP_NAME in the landing
# page.
NEXT_PUBLIC_APP_NAME=

# Support address shown on the error pages.
# OPTIONAL.
# If unset: the error pages show the placeholder "support@example.com". (Unlike
# the landing page's /contact route, nothing here fails the build.)
NEXT_PUBLIC_SUPPORT_EMAIL=

# =============================================================================
# APPLICATION URLS
# =============================================================================

# Public URL of this web app.
# REQUIRED (TURBOPLAN_URL satisfies the check instead).
# If unset: startup throws "Missing `TURBOPLAN_URL` or
# `NEXT_PUBLIC_TURBOPLAN_URL` env variable".
# Local value: http://localhost:3000
NEXT_PUBLIC_TURBOPLAN_URL=http://localhost:3000

# URL of the Hono API server. Every data request goes here.
# REQUIRED.
# If unset: startup throws "Missing `NEXT_PUBLIC_SERVER_URL` env variable".
# If wrong: every page loads but all data fetches fail.
# Local value: http://localhost:3001
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# URL of the landing page.
# OPTIONAL.
# If unset: LANDING_URL resolves to "" — the sign-in/sign-out redirect allowlist
# degrades to same-origin only, so a callbackUrl pointing at the landing page is
# rejected, and Stripe checkout redirects fall back to this app.
# Local value: http://localhost:3002
NEXT_PUBLIC_LANDING_URL=

# =============================================================================
# RESEARCH AGENT
# =============================================================================

# How often (ms) the UI polls a research agent run for status and messages.
# OPTIONAL — only meaningful when
# NEXT_PUBLIC_IS_RESEARCH_AGENT_INTEGRATION_PACKAGE_ENABLED is true.
# If unset or non-numeric: falls back to 5000.
NEXT_PUBLIC_RESEARCH_AGENT_POLLING_INTERVAL=

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Node environment: development, production or test.
# OPTIONAL — Next.js sets it per command anyway (`next dev` -> development,
# `next build`/`next start` -> production).
# If unset: no failure; it only feeds the Sentry environment tag and the
# isLocalDevelopment() fail-closed check alongside APP_ENV.
NODE_ENV=development

# Port Next.js listens on.
# OPTIONAL and normally inert — the `dev` and `start` scripts pass `-p 3000`
# explicitly, which wins over this variable.
# If you do change the port, update NEXT_PUBLIC_TURBOPLAN_URL and the API
# server's ALLOWED_ORIGINS to match.
PORT=3000

# =============================================================================
# TESTING
# =============================================================================

# The next three are read only by apps/turboplan/lib/constants.ts
# (`isTestEnvironment`), which nothing currently imports — setting them has no
# observable effect today. They are kept so the flag can be re-wired without
# rediscovering the names.

# Base URL Playwright drives the app at.
# OPTIONAL — currently inert (see note above).
PLAYWRIGHT_TEST_BASE_URL=http://localhost:3000

# Marker that Playwright is driving the app.
# OPTIONAL — currently inert (see note above).
PLAYWRIGHT=

# Marker that Playwright is running in CI.
# OPTIONAL — currently inert (see note above).
CI_PLAYWRIGHT=

# =============================================================================
# ERROR MONITORING (Sentry)
# =============================================================================

# Sentry DSN read by the BROWSER bundle. Inlined at build time, so a change
# needs a rebuild.
# OPTIONAL.
# If unset: Sentry.init receives an undefined DSN and no-ops — no monitoring,
# no errors.
# Get it from: Sentry -> Project Settings -> Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=

# Same DSN for the Node/edge runtime. NEXT_PUBLIC_SENTRY_DSN is used as the
# fallback, so setting only the public one covers both.
# OPTIONAL.
# If unset: server-side Sentry no-ops.
SENTRY_DSN=

# =============================================================================
# ANALYTICS (PostHog)
# =============================================================================

# PostHog project API key for browser-side analytics.
# OPTIONAL.
# If unset: posthog.init is never called; the provider renders its children
# untouched.
# Get it from: PostHog -> Project Settings -> Project API Key.
NEXT_PUBLIC_POSTHOG_KEY=

# PostHog ingestion host.
# OPTIONAL.
# If unset: defaults to "/ingest", the same-origin proxy that survives
# ad-blockers. Only set this to bypass the proxy.
NEXT_PUBLIC_POSTHOG_HOST=

# PostHog project API key for server-side events (login, chat) emitted from
# route handlers.
# OPTIONAL.
# If unset: server-side capture is skipped silently.
POSTHOG_API_KEY=
