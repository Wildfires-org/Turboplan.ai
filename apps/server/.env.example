# =============================================================================
# TurboPlan Server API Environment Variables
# =============================================================================
# Copy this file to `.env.local` in this directory:
#   cp .env.example .env.local
# `pnpm dev` runs on Bun, which auto-loads both `.env` and `.env.local` from
# this directory; `pnpm start` (the Node entry) reads `.env.local` explicitly.
# One exception: the billing catalog sync (`pnpm --filter
# @wildfires-org/turboplan-billing sync:stripe`) reads `apps/server/.env`, so
# copy the file under that name too if you use it.
#
# Env access goes through getApiEnv() in @wildfires-org/turboplan-env, which is
# called at module load in `src/index.ts` — any missing REQUIRED variable below
# throws before the server binds a port, and `pnpm dev` exits immediately.
#
# For the cross-cutting picture — which file each app reads, the four auth
# secrets, the minimum local setup, feature flags and deployment — see
# CONFIGURATION.md at the repo root.
# =============================================================================

# =============================================================================
# DATABASE
# =============================================================================

# PostgreSQL connection URL. Format: postgresql://user:password@host:port/database
# REQUIRED. (The e2e runner injects its own database via TEST_POSTGRES_URL —
# do not set that here; it belongs only in e2e/.env.)
# If unset: startup throws "Missing database URL: set `POSTGRES_URL` or
# `TEST_POSTGRES_URL` env variable".
# Must point at the same database as the web app's POSTGRES_URL.
POSTGRES_URL=postgresql://user:password@localhost:5432/turboplan

# =============================================================================
# AUTHENTICATION
# =============================================================================
# All four are independent secrets. Generate each one separately — reusing a
# single value for all four defeats the point of the split. See CONFIGURATION.md.

# Secret for the NextAuth session cookie (JWE) and the analytics email HMAC seed.
# REQUIRED.
# If unset: startup throws "Missing `AUTH_SECRET` env variable".
# Generate using: openssl rand -base64 32
# Must be byte-identical to AUTH_SECRET in apps/turboplan and apps/landing-page.
AUTH_SECRET=change-me

# Shared secret guarding the internal magic-link email endpoint; the web app
# sends it as the `X-Internal-Secret` header.
# REQUIRED.
# If unset: startup throws "Missing `INTERNAL_API_SECRET` env variable".
# If it does not match the web app's: magic-link emails are rejected with 401
# and nobody can log in.
# Generate using: openssl rand -base64 32
# Must be byte-identical to INTERNAL_API_SECRET in apps/turboplan.
INTERNAL_API_SECRET=change-me

# AES-256-GCM key for secrets stored at rest (per-org third-party keys).
# REQUIRED. API server only — no other service needs it.
# If unset: startup throws "Missing `ENCRYPTION_KEY` env variable".
# Rotating it makes every already-encrypted value permanently unreadable.
# Generate using: openssl rand -base64 32
ENCRYPTION_KEY=change-me

# HS256 key used to verify the API tokens the web app mints.
# REQUIRED.
# If unset: startup throws "Missing `JWT_SIGNING_SECRET` env variable".
# If it does not match the web app's: every authenticated API call fails
# signature verification and returns 401.
# Generate using: openssl rand -base64 32
# Must be byte-identical to JWT_SIGNING_SECRET in apps/turboplan.
JWT_SIGNING_SECRET=change-me

# =============================================================================
# BRANDING
# =============================================================================

# Application display name used in email subjects and templates.
# OPTIONAL (strongly recommended).
# If unset: getAppName() falls back to the literal string "[Your Brand]", which
# then appears in every outgoing email subject line.
# Should match NEXT_PUBLIC_APP_NAME in apps/turboplan and apps/landing-page.
APP_NAME=

# =============================================================================
# APPLICATION URLS
# =============================================================================

# Public URL of the web app. Used for links in emails and as the HTTP-Referer
# header on OpenRouter calls.
# REQUIRED (NEXT_PUBLIC_TURBOPLAN_URL satisfies the check instead).
# If unset: startup throws "Missing `TURBOPLAN_URL` or
# `NEXT_PUBLIC_TURBOPLAN_URL` env variable".
# Local value: http://localhost:3000
TURBOPLAN_URL=http://localhost:3000

# Public URL of this API server, used when an external service (the research
# agent) needs a callback target.
# OPTIONAL.
# If unset: getServerUrl() returns "" and research-agent callbacks are pointed
# at an empty base URL, so results never come back.
# Local value: http://localhost:3001
SERVER_URL=

# Public tunnel URL for local development (ngrok, cloudflared).
# OPTIONAL, dev only.
# If unset: SERVER_URL is used as the research-agent callback target instead.
# Example: https://your-tunnel.ngrok.io
LOCAL_TUNNEL_URL=

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# The server reads the non-prefixed names; the NEXT_PUBLIC_ variants also count.
# Only the literal string "true" (any case) enables a module — "1" and "yes" do
# NOT. Four of them (TASKS, MAPS, PROJECT_CONTEXT, RESEARCH_AGENT_INTEGRATION)
# are presence-checked at startup: they must be set to something, even "false",
# or the server throws. The rest default to off when absent. Keep every value in
# sync with apps/turboplan, or the UI will offer features the API refuses to
# serve.
#
# Defaults below turn on everything that works with no extra setup. MAPS,
# RESEARCH_AGENT_INTEGRATION, SIGNING and BILLING stay "false" because enabling
# any of them makes further variables required and the server throws at startup
# without them — see each entry.

# Tasks and milestones module.
# REQUIRED to be present (value "true" or "false").
# If unset: startup throws "Missing `IS_TASKS_PACKAGE_ENABLED` or
# `NEXT_PUBLIC_IS_TASKS_PACKAGE_ENABLED` env variable".
IS_TASKS_PACKAGE_ENABLED=true

# Custom project fields module.
# OPTIONAL — defaults to off when absent (not presence-checked).
# If unset: the fields routers are not mounted; the UI hides custom fields.
IS_FIELDS_PACKAGE_ENABLED=true

# Interactive maps module.
# REQUIRED to be present (value "true" or "false").
# If unset: startup throws "Missing `IS_MAPS_PACKAGE_ENABLED` or
# `NEXT_PUBLIC_IS_MAPS_PACKAGE_ENABLED` env variable".
# When "true", MAP_SERVICE_API_KEY and MAP_SERVICE_URL become required.
IS_MAPS_PACKAGE_ENABLED=false

# Project document uploads module (PDF, Word).
# OPTIONAL — defaults to off when absent (not presence-checked).
# If unset: the documents routers are not mounted. When "true", the R2_*
# variables below must be real or every upload returns 500.
IS_DOCUMENTS_PACKAGE_ENABLED=true

# Research agent integration module.
# REQUIRED to be present (value "true" or "false").
# If unset: startup throws "Missing
# `IS_RESEARCH_AGENT_INTEGRATION_PACKAGE_ENABLED` or the NEXT_PUBLIC_ variant".
# When "true", RESEARCH_AGENT_SERVICE_URL and _API_KEY become required.
IS_RESEARCH_AGENT_INTEGRATION_PACKAGE_ENABLED=false

# Project context module.
# REQUIRED to be present (value "true" or "false").
# If unset: startup throws "Missing `IS_PROJECT_CONTEXT_PACKAGE_ENABLED` or
# `NEXT_PUBLIC_IS_PROJECT_CONTEXT_PACKAGE_ENABLED` env variable".
IS_PROJECT_CONTEXT_PACKAGE_ENABLED=true

# Project timeline / activity log module.
# OPTIONAL — defaults to off when absent (not presence-checked).
# If unset: the timeline routers are not mounted and no activity is recorded.
IS_TIMELINE_RECORDS_PACKAGE_ENABLED=true

# Document signing module (Documenso).
# OPTIONAL — defaults to off when absent (not presence-checked).
# When "true", all three DOCUMENSO_* variables below become required and the
# server throws at startup without them.
IS_SIGNING_PACKAGE_ENABLED=false

# Stripe billing module.
# OPTIONAL — defaults to off when absent (not presence-checked).
# When "true", STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET become required and
# the server throws at startup without them.
IS_BILLING_PACKAGE_ENABLED=false

# =============================================================================
# BILLING (Stripe)
# =============================================================================
# Use TEST mode keys for development. Prefer a restricted key (rk_) over a full
# secret key (sk_). Plan, seat and overage prices are NOT env vars — they
# resolve at runtime from catalog lookup keys defined in
# packages/modules/turboplan-billing/catalog/pricing.yaml. Create the matching
# Stripe objects with:
#   pnpm --filter @wildfires-org/turboplan-billing sync:stripe -- --apply

# Stripe API secret or restricted key (sk_test_... / rk_test_...).
# REQUIRED when IS_BILLING_PACKAGE_ENABLED is true.
# If unset with billing on: startup throws "Missing `STRIPE_SECRET_KEY` env
# variable". With billing off it is ignored entirely.
# Get it from: Stripe Dashboard -> Developers -> API keys.
STRIPE_SECRET_KEY=

# Signing secret for the Stripe webhook endpoint (whsec_...).
# REQUIRED when IS_BILLING_PACKAGE_ENABLED is true.
# If unset with billing on: startup throws "Missing `STRIPE_WEBHOOK_SECRET` env
# variable". If wrong: every webhook is rejected as an invalid signature, so
# subscriptions never activate after checkout.
# For local dev use the value printed by:
#   stripe listen --forward-to localhost:3001/api/billing/stripe-webhook
STRIPE_WEBHOOK_SECRET=

# Shared secret for the manual seat-reconciliation endpoint
# (POST /api/billing/reconcile), compared against the `x-reconcile-secret`
# request header.
# OPTIONAL.
# If unset: the endpoint stays disabled and returns 404 — reconciliation only
# runs on its normal triggers. Lets an external scheduler drive it instead.
# Generate using: openssl rand -base64 32
RECONCILE_SECRET=

# Landing page base URL — the Stripe Checkout cancel redirect target.
# OPTIONAL (NEXT_PUBLIC_LANDING_URL satisfies it too).
# If unset: LANDING_URL resolves to "" and a cancelled checkout redirects to a
# malformed URL.
# Local value: http://localhost:3002
LANDING_URL=http://localhost:3002

# =============================================================================
# DOCUMENT SIGNING (Documenso)
# =============================================================================
# For local dev, run the Documenso stack in docker/documenso (port 3004).

# Base URL of the Documenso instance.
# REQUIRED when IS_SIGNING_PACKAGE_ENABLED is true.
# If unset with signing on: startup throws "Missing `DOCUMENSO_API_URL` env
# variable". With signing off it is ignored entirely.
# Local value: http://localhost:3004
DOCUMENSO_API_URL=

# Documenso API token.
# REQUIRED when IS_SIGNING_PACKAGE_ENABLED is true.
# If unset with signing on: startup throws "Missing `DOCUMENSO_API_KEY` env
# variable". If wrong: signing requests come back 401 from Documenso.
# Create it in Documenso: User settings -> API Tokens.
DOCUMENSO_API_KEY=

# Secret Documenso signs its outgoing webhooks with.
# REQUIRED when IS_SIGNING_PACKAGE_ENABLED is true.
# If unset with signing on: startup throws "Missing `DOCUMENSO_WEBHOOK_SECRET`
# env variable". If wrong: completed-signature callbacks are rejected and
# documents stay stuck as "pending".
# Set it when creating the webhook in Documenso.
DOCUMENSO_WEBHOOK_SECRET=

# =============================================================================
# AI PROVIDERS
# =============================================================================

# OpenRouter API key — the single model provider for chat, titles, suggestions
# and image generation.
# REQUIRED for any AI feature (validated lazily, not at startup).
# If unset: the server still boots, but the first AI call throws "Missing
# `OPENROUTER_API_KEY` env variable" and that route returns 500.
# Get it from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key

# Primary language model — chat, reasoning, artifacts, auto-responder.
# OPTIONAL. Resolution order: database config (admin panel) -> this variable ->
# built-in default (anthropic/claude-sonnet-4.6).
# If unset: the built-in default is used.
OPENROUTER_MODEL_PRIMARY=

# Lightweight language model — titles, suggestions, prompt validation.
# OPTIONAL. Same resolution order.
# If unset: the built-in default is used (anthropic/claude-haiku-4.5).
OPENROUTER_MODEL_LITE=

# Image model for user-triggered image generation.
# OPTIONAL. Same resolution order.
# If unset: the built-in default is used (google/gemini-2.5-flash-image).
OPENROUTER_MODEL_IMAGE_PRIMARY=

# Image model for auto-generated project cover images.
# OPTIONAL. Same resolution order.
# If unset: the built-in default is used (google/gemini-2.5-flash-image).
OPENROUTER_MODEL_IMAGE_LITE=

# =============================================================================
# AI FEATURES
# =============================================================================

# Turns OFF automatic AI cover-image generation for new projects.
# OPTIONAL — only the literal "true" disables generation.
# If unset: new projects get an auto-generated cover, which costs an
# OpenRouter image call and needs working R2 credentials to store the result.
DISABLE_AUTO_PROJECT_IMAGE_GENERATION=false

# Load prompts from the database (admin panel) instead of the ones bundled in
# code.
# OPTIONAL, dev/test only — only the literal "true" enables it.
# If unset: the prompts compiled into @wildfires-org/turboplan-ai are used.
# With "true" and an empty prompt table, prompt lookups fail — seed first with
# `pnpm seed:prompts`.
USE_EXTERNAL_PROMPTS=

# PIPE-separated (`|`, not comma) emails allowed into the admin panel (prompts,
# AI models, webhook logs).
# OPTIONAL.
# If unset: isSuperAdmin() is false for everyone and every admin route 403s.
# A comma-separated value silently matches nobody — the whole string is treated
# as one address.
# Example: you@example.com|teammate@example.com
ADMIN_EMAILS=

# =============================================================================
# FILE STORAGE (Cloudflare R2)
# =============================================================================
# All five are validated together by getR2Env(), lazily on first use — the
# server boots without them, but any upload, document or image-generation route
# then returns 500 with "Missing `R2_...` env variable". The one exception is
# the automatic project cover image, which runs in the background: its failure
# is caught and logged, so project creation still succeeds without a cover.
# Create a bucket and an S3-compatible API token at:
#   Cloudflare Dashboard -> R2 -> Manage R2 API Tokens

# R2 access key ID (S3-compatible credential).
# REQUIRED for uploads, documents and generated images; the rest of the app
# works without it.
# If unset: those routes 500 as described above.
R2_ACCESS_KEY_ID=your-r2-access-key-id

# R2 secret access key.
# REQUIRED for uploads, documents and generated images.
# If unset: those routes 500. If wrong: R2 returns a 403 signature error.
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Name of the R2 bucket objects are written to.
# REQUIRED for uploads, documents and generated images.
# If unset: those routes 500. If the bucket does not exist: uploads 404.
R2_BUCKET_NAME=your-bucket-name

# Cloudflare account ID that owns the bucket (Dashboard -> Overview, right
# sidebar) — it forms the S3 endpoint hostname.
# REQUIRED for uploads, documents and generated images.
# If unset: those routes 500.
R2_ACCOUNT_ID=your-cloudflare-account-id

# Public base URL of the bucket, used to build the URLs stored in the database.
# REQUIRED for uploads, documents and generated images.
# If unset: those routes 500. If wrong: files upload but render as broken
# images, and the web app's next/image allowlist rejects them.
# Example: https://pub-xxxx.r2.dev (or a custom domain bound to the bucket)
R2_PUBLIC_URL=

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# Comma- or pipe-separated list of browser origins allowed to call this API.
# REQUIRED.
# If unset: startup throws "Missing `ALLOWED_ORIGINS` env variable".
# If incomplete: the browser blocks the web app's requests as CORS failures.
# When NODE_ENV is development or test, any localhost origin is allowed on top
# of this list; otherwise only https:// origins on the list are accepted.
# Example: http://localhost:3000,https://app.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000

# =============================================================================
# SERVICE AUTHENTICATION
# =============================================================================

# Universal API key for service-to-service (webhook) calls into this server,
# compared in constant time against the caller's key.
# REQUIRED.
# If unset: startup throws "Missing `SERVER_API_KEY` env variable".
# If wrong: every webhook route returns 401.
# Generate using: openssl rand -base64 32
SERVER_API_KEY=change-me

# =============================================================================
# MAP SERVICE
# =============================================================================

# Shared secret sent as `X-API-Key` to the Python map service.
# REQUIRED when IS_MAPS_PACKAGE_ENABLED is true.
# If unset with maps on: startup throws "Missing `MAP_SERVICE_API_KEY` env
# variable". If wrong: the map service answers 401 and GIS uploads fail.
# Generate using: openssl rand -base64 32
# Must be byte-identical to MAP_SERVICE_API_KEY in
# packages/services/turboplan-map-server.
MAP_SERVICE_API_KEY=

# Base URL where the Python map service is running.
# REQUIRED when IS_MAPS_PACKAGE_ENABLED is true.
# If unset with maps on: startup throws "Missing `MAP_SERVICE_URL` env variable".
# Local value: http://localhost:9000 (`make run` in the map-server package).
MAP_SERVICE_URL=

# =============================================================================
# RESEARCH AGENT SERVICE
# =============================================================================

# Base URL where apps/research-agent is running.
# REQUIRED when IS_RESEARCH_AGENT_INTEGRATION_PACKAGE_ENABLED is true.
# If unset with the module on: startup throws "Missing
# `RESEARCH_AGENT_SERVICE_URL` env variable".
# Local value: http://localhost:3003
RESEARCH_AGENT_SERVICE_URL=

# API key this server presents to the research agent.
# REQUIRED when IS_RESEARCH_AGENT_INTEGRATION_PACKAGE_ENABLED is true.
# If unset with the module on: startup throws "Missing
# `RESEARCH_AGENT_SERVICE_API_KEY` env variable". If wrong: the agent rejects
# every run request with 401.
# Generate using: openssl rand -base64 32
# Must be byte-identical to AGENT_API_KEY in apps/research-agent.
RESEARCH_AGENT_SERVICE_API_KEY=

# =============================================================================
# EMAIL SERVICE
# =============================================================================
# Provider selection is automatic, in this order: RESEND_API_KEY set -> Resend;
# else ETHEREAL_USER and ETHEREAL_PASS both set -> Ethereal; else a no-op
# provider that logs one warning at startup and then silently DROPS every
# message. Magic-link login still "succeeds" under the no-op provider, but no
# email is ever delivered — mint a login link directly instead, see
# CONFIGURATION.md.

# Resend API key — real email delivery.
# OPTIONAL.
# If unset: falls back to Ethereal, then to the silent no-op provider.
# Get it from: https://resend.com/api-keys
RESEND_API_KEY=

# Default From: address on outgoing mail.
# REQUIRED when RESEND_API_KEY is set.
# If unset: resolves to "" and Resend rejects the send for a missing sender.
# Must be an address on a domain verified in Resend, or onboarding@resend.dev
# for testing.
RESEND_FROM_EMAIL=onboarding@resend.dev

# Reply-To applied to all outgoing mail when an email does not set its own.
# OPTIONAL.
# If unset: outgoing mail carries no Reply-To header at all, so replies go to
# RESEND_FROM_EMAIL. There is deliberately no default — a hardcoded address
# would send every fork's replies to an inbox it does not own.
MAIL_REPLY_TO_EMAIL=

# Ethereal SMTP username — captures dev/e2e mail in a throwaway web inbox at
# https://ethereal.email/messages instead of delivering it.
# OPTIONAL.
# If unset (or if ETHEREAL_PASS is unset): the Ethereal provider is not chosen
# at all and mail falls through to the silent no-op provider.
# Create an account at: https://ethereal.email/create
ETHEREAL_USER=

# Ethereal SMTP password.
# OPTIONAL — only meaningful together with ETHEREAL_USER.
# If unset: same fallback as ETHEREAL_USER.
ETHEREAL_PASS=

# =============================================================================
# ANALYTICS (PostHog)
# =============================================================================

# PostHog project API key for server-side event capture.
# OPTIONAL.
# If unset: analytics capture is skipped entirely; no errors.
# Get it from: PostHog -> Project Settings -> Project API Key.
POSTHOG_API_KEY=

# =============================================================================
# ERROR MONITORING (Sentry)
# =============================================================================

# Sentry DSN for the API server project.
# OPTIONAL.
# If unset: Sentry is never initialized — errors are logged to stdout only.
# Get it from: Sentry -> Project Settings -> Client Keys (DSN).
SENTRY_DSN=

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Node environment: development, production or test.
# OPTIONAL — defaults to "" inside the env module.
# If unset: CORS drops its localhost exemption and only allowlisted https://
# origins are accepted, which usually breaks local browser calls.
NODE_ENV=development

# Port this server listens on.
# OPTIONAL — defaults to 3001 when unset.
# Changing it means updating NEXT_PUBLIC_SERVER_URL and ALLOWED_ORIGINS to match.
PORT=3001
