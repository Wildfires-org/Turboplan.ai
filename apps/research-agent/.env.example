# =============================================================================
# TurboPlan Research Agent Environment Variables
# =============================================================================
# Copy this file to `.env.local` in this directory:
#   cp .env.example .env.local
# `.env.local` (not `.env`) is the required name — the dev script runs
# `tsx watch --env-file=.env.local`, which fails outright if the file is absent.
# The separate `deploy:agent` script reads `.env.deploy` instead.
#
# This app is optional. It is only needed when the research agent module is on
# (IS_RESEARCH_AGENT_INTEGRATION_PACKAGE_ENABLED = true) and it is deliberately
# excluded from the root `pnpm dev`.
#
# Env access goes through getResearchAgentEnv() in @wildfires-org/turboplan-env,
# called at module load in `src/app/instrument.ts` — a missing REQUIRED value
# throws before the server binds a port.
#
# For the cross-cutting picture — which file each app reads, the four auth
# secrets, the minimum local setup, feature flags and deployment — see
# CONFIGURATION.md at the repo root.
# =============================================================================

# ------------------------------------------------------------------
# Authentication
# ------------------------------------------------------------------

# API key required on every /api/agent/* request.
# REQUIRED.
# If unset or blank: startup throws "Missing `AGENT_API_KEY` env variable".
# If it does not match the caller's, every run request is rejected with 401.
# Generate using: openssl rand -base64 32
# Must be byte-identical to RESEARCH_AGENT_SERVICE_API_KEY in apps/server.
AGENT_API_KEY=change-me

# ------------------------------------------------------------------
# Server configuration
# ------------------------------------------------------------------

# Comma-separated list of browser origins allowed to call this service.
# OPTIONAL.
# If unset: defaults to ["*"], i.e. any origin. Callers are the API server and
# authenticate by API key, so this is mostly a defence-in-depth setting.
# Example: https://app.yourdomain.com
ALLOWED_ORIGINS=*

# Port this service listens on.
# OPTIONAL — defaults to 3003 when unset or non-numeric.
# Changing it means updating RESEARCH_AGENT_SERVICE_URL in apps/server.
PORT=3003

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------

# PostgreSQL connection URL — the agent persists run state and messages here.
# REQUIRED.
# If unset: the first database call throws "Missing database URL: set
# `POSTGRES_URL` or `TEST_POSTGRES_URL` env variable" and runs cannot start.
# Must point at the same database as apps/server.
POSTGRES_URL=postgresql://user:password@localhost:5432/turboplan

# ------------------------------------------------------------------
# Agent runtime
# ------------------------------------------------------------------

# Run the agent as a local subprocess instead of a Modal sandbox.
# OPTIONAL — only the literal "true" enables it. Commented out by default.
# If set to "true": the Modal and model-provider checks below are skipped
# entirely, which is the easiest way to run this service locally.
# If left unset: MODAL_TOKEN_ID, MODAL_TOKEN_SECRET and a model provider key all
# become required at startup.
# AGENT_LOCAL=true

# Modal workspace token ID — identifies the sandbox account runs execute in.
# REQUIRED unless AGENT_LOCAL=true.
# If unset: startup throws "Missing required Modal env variables:
# MODAL_TOKEN_ID... Set them in .env or set AGENT_LOCAL=true for local
# development."
# Get it from: https://modal.com -> Settings -> API Tokens.
MODAL_TOKEN_ID=your-modal-token-id

# Modal workspace token secret.
# REQUIRED unless AGENT_LOCAL=true.
# If unset: same startup throw as MODAL_TOKEN_ID.
MODAL_TOKEN_SECRET=your-modal-token-secret

# Anthropic API key, passed through to the agent runtime / Modal sandbox.
# REQUIRED unless AGENT_LOCAL=true or OPENROUTER_API_KEY is set.
# If neither key is set: startup throws "Missing model provider key: set
# ANTHROPIC_API_KEY or OPENROUTER_API_KEY."
# Get it from: https://console.anthropic.com -> API Keys.
ANTHROPIC_API_KEY=sk-ant-your-api-key

# OpenRouter key — routes all model traffic (Agent SDK plus the fast model)
# through OpenRouter's Anthropic-compatible endpoint for per-key cost tracking.
# OPTIONAL. Takes precedence over ANTHROPIC_API_KEY when set.
# If unset: the direct Anthropic API is used.
# Get it from: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-your-api-key

# Model the agent reasons with.
# OPTIONAL — defaults to claude-sonnet-4-6 when unset.
CLAUDE_MODEL=claude-sonnet-4-6

# Fast model used for keyword extraction in the memory layer.
# OPTIONAL.
# If unset or blank: resolves to null and the memory layer falls back to plain
# text splitting instead of model-extracted keywords.
CLAUDE_FAST_MODEL=claude-haiku-4-5-20251001

# Maximum wall-clock time for one agent run, in milliseconds.
# OPTIONAL — defaults to 600000 (10 minutes) when unset, non-numeric, or <= 0.
# If a run exceeds it, the run is terminated and marked failed.
RUN_TIMEOUT_MS=600000

# ------------------------------------------------------------------
# Target API (data submission back to the backend)
# ------------------------------------------------------------------

# Path appended to the caller-supplied target API base URL when the agent posts
# its results back.
# OPTIONAL — defaults to "" when unset, which makes the agent POST results to
# the bare base URL and the webhook never lands.
# Keep it aligned with the webhook route mounted in apps/server.
TARGET_API_ROOT_PATH=/api/webhooks/research-agent

# Health-check path.
# OPTIONAL and currently inert — referenced only by `fly.toml` for the deploy
# health check; no application code reads it.
TARGET_API_HEALTH_PATH=/health

# ------------------------------------------------------------------
# Logging and debugging
# ------------------------------------------------------------------

# Include error stack traces in logs.
# OPTIONAL — inverted truthiness: ANY value other than the exact string "false"
# means enabled, including an empty string and "0".
# If unset: stack traces are logged. Set exactly "false" to suppress them.
LOG_STACK_TRACES=true

# Print the Claude Agent SDK's [DEBUG] logs to stderr.
# OPTIONAL — only the literal "true" enables it. Commented out by default.
# If unset: SDK debug output is suppressed.
# DEBUG_CLAUDE_AGENT_SDK=true

# ------------------------------------------------------------------
# Optional integrations
# ------------------------------------------------------------------

# Firecrawl API key — lets the agent scrape bot-protected pages.
# OPTIONAL.
# If unset: it is forwarded to the sandbox as an empty string and those scrapes
# fail; the agent falls back to plain fetching and keeps running.
# Get it from: https://firecrawl.dev
# FIRECRAWL_API_KEY=fc-your-api-key

# Sentry DSN for the research-agent project.
# OPTIONAL.
# If unset: Sentry is never initialized — errors are logged to stdout only.
# Get it from: Sentry -> Project Settings -> Client Keys (DSN).
# SENTRY_DSN=

# PostHog project API key for run-lifecycle analytics.
# OPTIONAL.
# If unset: analytics capture is skipped silently.
# Get it from: PostHog -> Project Settings -> Project API Key.
# POSTHOG_API_KEY=
