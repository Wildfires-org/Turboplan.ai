{
  "name": "@wildfires-org/turboplan-timeline-records",
  "version": "1.0.0",
  "private": true,
  "description": "Project timeline records (activity log) module for TurboPlan",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test $(find tests -name '*.test.ts')"
  },
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    }
  },
  "dependencies": {
    "@wildfires-org/turboplan-db": "workspace:*",
    "@wildfires-org/turboplan-rbac": "workspace:*",
    "@wildfires-org/turboplan-utils": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "lucide-react": "^0.446.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.4",
    "@types/node": "^20.10.5",
    "@types/react": "^19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rollup-plugin-preserve-use-client": "^3.0.1",
    "tsdown": "^0.15.9",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3"
  }
}
