{
  "name": "@wildfires-org/turboplan-documents",
  "description": "Document upload and management UI for TurboPlan projects",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    }
  },
  "dependencies": {
    "@wildfires-org/turboplan-db": "workspace:*",
    "@wildfires-org/turboplan-api-client": "workspace:*",
    "@wildfires-org/turboplan-document-extraction": "workspace:*",
    "@wildfires-org/turboplan-rbac": "workspace:*",
    "@wildfires-org/turboplan-upload": "workspace:*",
    "@wildfires-org/turboplan-utils": "workspace:*",
    "@wildfires-org/turboplan-workspace": "workspace:*",
    "docx-preview": "^0.3.3",
    "lucide-react": "^0.446.0",
    "pdfjs-dist": "4.8.69",
    "react-dropzone": "^14.3.8",
    "react-pdf": "^9.2.1",
    "sonner": "^1.5.0",
    "swr": "^2.2.5"
  },
  "peerDependencies": {
    "next": ">=15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.4",
    "@types/node": "^20.10.5",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.7",
    "next": "15.5.25",
    "react": "19.1.7",
    "react-dom": "19.1.7",
    "rollup-plugin-preserve-use-client": "^3.0.1",
    "tsdown": "^0.15.9",
    "typescript": "^5.3.3"
  }
}
