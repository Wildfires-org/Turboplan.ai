{
  "name": "@wildfires-org/turboplan-research-agent-integration",
  "version": "1.0.0",
  "private": true,
  "description": "Research agent integration package for TurboPlan",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test $(find tests -name '*.test.ts')"
  },
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    }
  },
  "dependencies": {
    "@hono/zod-validator": "^0.8.0",
    "@rive-app/react-webgl2": "^4.27.0",
    "@wildfires-org/turboplan-ai": "workspace:*",
    "@wildfires-org/turboplan-api-client": "workspace:*",
    "@wildfires-org/turboplan-billing": "workspace:*",
    "@wildfires-org/turboplan-db": "workspace:*",
    "@wildfires-org/turboplan-documents": "workspace:*",
    "@wildfires-org/turboplan-env": "workspace:*",
    "@wildfires-org/turboplan-feature-flags": "workspace:*",
    "@wildfires-org/turboplan-project-context": "workspace:*",
    "@wildfires-org/turboplan-rbac": "workspace:*",
    "@wildfires-org/turboplan-timeline-records": "workspace:*",
    "@wildfires-org/turboplan-upload": "workspace:*",
    "@wildfires-org/turboplan-utils": "workspace:*",
    "@wildfires-org/turboplan-workspace": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.14.0",
    "hono": "^4.7.5",
    "lucide-react": "^0.446.0",
    "postgres": "^3.4.4",
    "sonner": "^1.7.4",
    "swr": "^2.2.5",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.4",
    "@types/node": "^20.10.5",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.7",
    "react": "19.1.7",
    "react-dom": "19.1.7",
    "rollup-plugin-preserve-use-client": "^3.0.1",
    "tsdown": "^0.15.9",
    "tsx": "^4.19.0",
    "typescript": "^5.3.3"
  }
}
