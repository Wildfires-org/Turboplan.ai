{
  "name": "@wildfires-org/turboplan-document-extraction",
  "description": "Server-only PDF/DOC/DOCX text extraction for TurboPlan",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test $(find tests -name '*.test.ts')"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./mime": {
      "types": "./dist/document-mime.d.ts",
      "import": "./dist/document-mime.js",
      "default": "./dist/document-mime.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js",
      "default": "./dist/errors.js"
    },
    "./limits": {
      "types": "./dist/limits.d.ts",
      "import": "./dist/limits.js",
      "default": "./dist/limits.js"
    },
    "./download": {
      "types": "./dist/download.d.ts",
      "import": "./dist/download.js",
      "default": "./dist/download.js"
    },
    "./letterhead": {
      "types": "./dist/letterhead.d.ts",
      "import": "./dist/letterhead.js",
      "default": "./dist/letterhead.js"
    }
  },
  "dependencies": {
    "mammoth": "^1.13.0",
    "unpdf": "^1.9.1",
    "word-extractor": "1.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.4",
    "@types/node": "^20.10.5",
    "@types/word-extractor": "^1.0.6",
    "tsdown": "^0.15.9",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3"
  }
}
