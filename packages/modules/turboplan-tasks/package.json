{
  "name": "@wildfires-org/turboplan-tasks",
  "version": "1.0.0",
  "private": true,
  "description": "Task and milestone management package for TurboPlan",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --experimental-test-module-mocks --test $(find tests -name '*.test.ts')"
  },
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "default": "./dist/types/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js",
      "default": "./dist/components/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js",
      "default": "./dist/hooks/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js",
      "default": "./dist/providers/index.js"
    },
    "./services": {
      "types": "./dist/services/task-service.d.ts",
      "import": "./dist/services/task-service.js",
      "default": "./dist/services/task-service.js"
    },
    "./artifact/server": {
      "types": "./dist/artifact/server.d.ts",
      "import": "./dist/artifact/server.js",
      "default": "./dist/artifact/server.js"
    },
    "./artifact/client": {
      "types": "./dist/artifact/client.d.ts",
      "import": "./dist/artifact/client.js",
      "default": "./dist/artifact/client.js"
    },
    "./prompts": {
      "types": "./dist/prompts.d.ts",
      "import": "./dist/prompts.js",
      "default": "./dist/prompts.js"
    }
  },
  "dependencies": {
    "@hono/zod-validator": "^0.8.0",
    "@hookform/resolvers": "^5.4.0",
    "@wildfires-org/turboplan-ai": "workspace:*",
    "@wildfires-org/turboplan-api-client": "workspace:*",
    "@wildfires-org/turboplan-billing": "workspace:*",
    "@wildfires-org/turboplan-db": "workspace:*",
    "@wildfires-org/turboplan-documents": "workspace:*",
    "@wildfires-org/turboplan-env": "workspace:*",
    "@wildfires-org/turboplan-gantt-task": "workspace:*",
    "@wildfires-org/turboplan-mail": "workspace:*",
    "@wildfires-org/turboplan-rbac": "workspace:*",
    "@wildfires-org/turboplan-timeline-records": "workspace:*",
    "@wildfires-org/turboplan-utils": "workspace:*",
    "ai": "^6.0.191",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.5",
    "lodash": "^4.17.21",
    "lucide-react": "^0.446.0",
    "next-auth": "5.0.0-beta.32",
    "postgres": "^3.4.4",
    "react-hook-form": "^7.75.0",
    "tw-animate-css": "^1.3.4",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.6"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.4",
    "@types/lodash": "^4.17.1",
    "@types/node": "^20.10.5",
    "@types/react": "^19.1.2",
    "eslint": "9.25.1",
    "react": "19.1.7",
    "react-dom": "19.1.7",
    "rollup-plugin-preserve-use-client": "^3.0.1",
    "tsdown": "^0.15.9",
    "tsx": "^4.19.1",
    "typescript": "^5.3.3"
  }
}
