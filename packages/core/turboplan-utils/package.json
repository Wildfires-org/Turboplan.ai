{
  "name": "@wildfires-org/turboplan-utils",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test $(find tests -name '*.test.ts')"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./app-paths": {
      "types": "./dist/app-paths.d.ts",
      "import": "./dist/app-paths.js",
      "default": "./dist/app-paths.js"
    },
    "./slug": {
      "types": "./dist/slug.d.ts",
      "import": "./dist/slug.js",
      "default": "./dist/slug.js"
    },
    "./ssrf": {
      "types": "./dist/ssrf.d.ts",
      "import": "./dist/ssrf.js",
      "default": "./dist/ssrf.js"
    }
  },
  "license": "MIT",
  "sideEffects": false,
  "dependencies": {
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@wildfires-org/turboplan-env": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.539.0",
    "sonner": "^1.5.0",
    "tailwind-merge": "^3.3.1",
    "usehooks-ts": "^3.1.1"
  },
  "peerDependencies": {
    "next": ">=15.5.28",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "rollup-plugin-preserve-use-client": "^3.0.1",
    "tsdown": "^0.15.9",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
