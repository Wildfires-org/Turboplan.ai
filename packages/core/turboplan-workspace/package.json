{
  "name": "@wildfires-org/turboplan-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Workspace entities (organizations, offices, projects) for TurboPlan",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test $(find tests -name '*.test.ts')",
    "seed:organizations": "tsx src/seed/organizations.ts"
  },
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    }
  },
  "dependencies": {
    "@hono/zod-validator": "^0.8.0",
    "@hookform/resolvers": "^5.4.0",
    "ai": "^6.0.191",
    "cmdk": "^1.0.4",
    "@wildfires-org/turboplan-ai": "workspace:*",
    "@wildfires-org/turboplan-api-client": "workspace:*",
    "@wildfires-org/turboplan-billing": "workspace:*",
    "@wildfires-org/turboplan-db": "workspace:*",
    "@wildfires-org/turboplan-env": "workspace:*",
    "@wildfires-org/turboplan-feature-flags": "workspace:*",
    "@wildfires-org/turboplan-mail": "workspace:*",
    "@wildfires-org/turboplan-rbac": "workspace:*",
    "@wildfires-org/turboplan-timeline-records": "workspace:*",
    "@wildfires-org/turboplan-upload": "workspace:*",
    "@wildfires-org/turboplan-utils": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.3",
    "react-hook-form": "^7.75.0",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "lucide-react": "^0.539.0",
    "react": "^19.1.1",
    "swr": "^2.0.0",
    "usehooks-ts": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/react": "^19.1.1",
    "dotenv": "^16.4.5",
    "rollup-plugin-preserve-use-client": "^3.0.1",
    "tsdown": "^0.15.9",
    "tsx": "^4.19.0",
    "typescript": "^5.3.3"
  }
}
