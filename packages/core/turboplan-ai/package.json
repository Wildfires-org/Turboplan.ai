{
  "name": "@wildfires-org/turboplan-ai",
  "version": "1.0.0",
  "private": true,
  "description": "AI services and prompts for TurboPlan",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "seed:prompts": "tsx src/seed/prompts.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./services": {
      "types": "./dist/services.d.ts",
      "import": "./dist/services.js",
      "default": "./dist/services.js"
    }
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "^2.9.0",
    "@wildfires-org/turboplan-api-client": "workspace:*",
    "@wildfires-org/turboplan-billing": "workspace:*",
    "@wildfires-org/turboplan-db": "workspace:*",
    "@wildfires-org/turboplan-env": "workspace:*",
    "@wildfires-org/turboplan-rbac": "workspace:*",
    "@wildfires-org/turboplan-upload": "workspace:*",
    "ai": "^6.0.191",
    "hono": "^4.7.5",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/react": "^19.1.1",
    "dotenv": "^16.4.5",
    "tsdown": "^0.15.9",
    "tsx": "^4.19.0",
    "typescript": "^5.3.3"
  }
}
