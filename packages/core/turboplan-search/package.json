{
  "name": "@wildfires-org/turboplan-search",
  "version": "1.0.0",
  "private": true,
  "description": "Cross-entity full-text search functionality for TurboPlan",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    }
  },
  "dependencies": {
    "@wildfires-org/turboplan-api-client": "workspace:*",
    "@wildfires-org/turboplan-db": "workspace:*",
    "@wildfires-org/turboplan-utils": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.3",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "lucide-react": "^0.539.0",
    "react": "^19.1.1",
    "swr": "^2.0.0",
    "usehooks-ts": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/react": "^19.1.1",
    "rollup-plugin-preserve-use-client": "^3.0.1",
    "tsdown": "^0.15.9",
    "typescript": "^5.3.3"
  }
}
