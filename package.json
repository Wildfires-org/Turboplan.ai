{
  "name": "TurboPlan",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "prepare": "husky",
    "test": "turbo run test --filter='./apps/*' --filter='./packages/**/*'",
    "dev": "pnpm dev:apps",
    "dev:apps": "turbo run dev --filter='./apps/*' --filter='!@wildfires-org/research-agent'",
    "dev:packages": "turbo run dev --filter='./packages/**/*'",
    "build": "turbo run build --filter='./apps/*' --filter='./packages/**/*'",
    "build:apps": "turbo run build --filter='./apps/*'",
    "build:packages": "turbo run build --filter='./packages/**/*'",
    "format": "biome check --linter-enabled=false",
    "format:write": "biome check --write --linter-enabled=false",
    "lint": "biome lint --unsafe",
    "lint:fix": "biome lint --unsafe --fix",
    "typecheck": "NODE_OPTIONS='--max-old-space-size=12288' turbo run typecheck --filter='./apps/*' --filter='./packages/**/*' --concurrency=1",
    "clean": "turbo run clean",
    "clean:cache": "find . \\( -name '.next' -o -name '.turbo' -o -name 'node_modules/.cache' -o -name '.cache' \\) -type d -prune -exec rm -rf '{}' +",
    "clean:full": "pnpm clean && pnpm clean:cache",
    "changeset": "changeset",
    "release:version": "changeset version && pnpm install --lockfile-only",
    "e2e:setup": "bash e2e/start-servers.sh",
    "e2e:teardown": "bash e2e/stop-servers.sh",
    "e2e:test": "turbo run test --filter='./e2e'",
    "e2e": "pnpm e2e:setup && pnpm e2e:test && pnpm e2e:teardown",
    "e2e:debug": "pnpm e2e:setup && pnpm --filter @wildfires-org/e2e-tests test:debug && pnpm e2e:teardown",
    "e2e:ui": "pnpm e2e:setup && pnpm --filter @wildfires-org/e2e-tests test:ui",
    "e2e:headed": "pnpm e2e:setup && pnpm --filter @wildfires-org/e2e-tests test:headed && pnpm e2e:teardown",
    "seed": "pnpm seed:organizations && pnpm seed:prompts",
    "seed:prompts": "pnpm --filter @wildfires-org/turboplan-ai seed:prompts",
    "seed:organizations": "pnpm --filter @wildfires-org/turboplan-workspace seed:organizations"
  },
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=22.23.4",
    "pnpm": ">=10.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.4",
    "@changesets/cli": "^3.0.2",
    "@opennextjs/cloudflare": "^1.20.12",
    "husky": "^9.1.7",
    "turbo": "^2.9.14",
    "wrangler": "^4.151.3"
  },
  "workspaces": [
    "packages/core/*",
    "packages/modules/*",
    "apps/*",
    "e2e"
  ],
  "pnpm": {
    "overrides": {
      "drizzle-orm": "^0.45.2",
      "hono": "^4.13.11",
      "react": "19.1.7",
      "react-dom": "19.1.7",
      "mammoth>@xmldom/xmldom": "^0.8.15",
      "modal>protobufjs": "^7.6.1",
      "modal>smol-toml": "^1.9.0",
      "nice-grpc>@grpc/grpc-js": "^1.14.4",
      "@modelcontextprotocol/sdk>@hono/node-server": "^1.19.10",
      "@auth/core>nodemailer": "^10.0.9",
      "next-auth>nodemailer": "^10.0.9",
      "next>sharp": "^0.35.5",
      "streamdown>mermaid": "^11.16.1",
      "prosemirror-markdown>markdown-it": "^14.3.3",
      "markdown-it>linkify-it": "^5.0.2",
      "@ai-sdk/provider-utils@>=4.0.0 <4.0.33": "^4.0.33",
      "@babel/core@>=7.0.0 <7.29.6": "^7.29.6",
      "@humanfs/node@>=0.16.0 <0.16.8": "^0.16.8",
      "@isaacs/brace-expansion@>=5.0.0 <5.0.1": "^5.0.1",
      "@tootallnate/once@>=2.0.0 <2.0.1": "^2.0.1",
      "@vue/server-renderer@>=3.0.0 <3.5.42": "^3.5.42",
      "ajv@>=6.0.0 <6.14.0": "^6.14.0",
      "ajv@>=8.0.0 <8.18.0": "^8.18.0",
      "axios@>=1.0.0 <1.20.0": "^1.20.0",
      "baseline-browser-mapping@>=2.0.0 <2.11.0": "^2.11.0",
      "body-parser@>=2.0.0 <2.3.0": "^2.3.0",
      "brace-expansion@>=1.0.0 <1.1.21": "^1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "^2.1.7",
      "brace-expansion@>=5.0.0 <5.0.12": "^5.0.12",
      "browserslist@>=4.0.0 <4.28.7": "^4.28.7",
      "defu@>=6.0.0 <6.1.5": "^6.1.5",
      "diff@>=4.0.0 <4.0.4": "^4.0.4",
      "diff@>=8.0.0 <8.0.3": "^8.0.3",
      "dompurify@>=3.0.0 <3.4.16": "^3.4.16",
      "fast-uri@>=3.0.0 <3.1.8": "^3.1.8",
      "flatted@>=3.0.0 <3.4.2": "^3.4.2",
      "follow-redirects@>=1.0.0 <1.16.0": "^1.16.0",
      "form-data@>=4.0.0 <4.0.6": "^4.0.6",
      "glob@>=10.0.0 <10.5.0": "^10.5.0",
      "image-size@>=2.0.0 <2.0.3": "^2.0.3",
      "ip-address@>=10.0.0 <10.7.1": "^10.7.1",
      "joi@>=18.0.0 <18.2.9": "^18.2.9",
      "js-yaml@>=3.0.0 <3.15.2": "^3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "lodash@>=4.0.0 <4.18.0": "^4.18.0",
      "mdast-util-to-hast@>=13.0.0 <13.2.1": "^13.2.1",
      "minimatch@>=10.0.0 <10.2.3": "^10.2.3",
      "minimatch@>=3.0.0 <3.1.4": "^3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "^9.0.7",
      "nanoid@>=3.0.0 <3.3.18": "^3.3.18",
      "nanoid@>=5.0.0 <5.1.16": "^5.1.16",
      "picomatch@>=2.0.0 <2.3.2": "^2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "postcss-selector-parser@>=6.1.0 <6.1.3": "^6.1.3",
      "postcss-selector-parser@>=7.0.0 <7.1.6": "^7.1.6",
      "postcss@>=8.0.0 <8.5.23": "^8.5.23",
      "prismjs@>=1.0.0 <1.30.0": "^1.30.0",
      "proxy-addr@>=2.0.0 <2.0.8": "^2.0.8",
      "qs@>=6.0.0 <6.16.0": "^6.16.0",
      "shell-quote@>=1.0.0 <1.11.0": "^1.11.0",
      "source-map-js@>=1.0.0 <1.2.2": "^1.2.2",
      "svelte@>=5.0.0 <5.55.7": "^5.55.7",
      "uuid@>=11.0.0 <11.1.1": "^11.1.1",
      "ws@>=8.0.0 <8.21.0": "^8.21.0",
      "yaml@>=1.0.0 <1.10.3": "^1.10.3",
      "yaml@>=2.0.0 <2.8.3": "^2.8.3"
    },
    "patchedDependencies": {
      "postgres@3.4.7": "patches/postgres@3.4.7.patch"
    }
  }
}
