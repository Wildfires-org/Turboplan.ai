# =============================================================================
# TurboPlan E2E Test Suite Environment Variables
# =============================================================================
# Copy this file to `.env` in this directory:
#   cp .env.example .env
# `pnpm e2e:test` runs Playwright through `dotenv -e .env`, and
# `e2e/load-env.sh` sources the same file before starting the servers.
#
# This ONE file configures the whole suite: `e2e/start-servers.sh` exports every
# value below into the environment of the web app, the API server and the
# landing page, so cross-service secrets are automatically identical. That is
# why a variable like AUTH_SECRET appears once here but three times across the
# app-level `.env.example` files.
#
# For the cross-cutting picture — which file each app reads, the four auth
# secrets, the minimum local setup, feature flags and deployment — see
# CONFIGURATION.md at the repo root.
#
# WARNING: the suite DROPS AND RECREATES the schema of whatever database
# TEST_POSTGRES_URL points at, before and after every run. Never point it at a
# database you care about.
# =============================================================================

# =============================================================================
# ENVIRONMENT
# =============================================================================

# Node environment. Must be exactly the string "test".
# REQUIRED.
# If unset or anything else: `e2e/global-setup.ts` throws "E2E tests require
# NODE_ENV=test, but got ..." before a single test runs. It also switches the
# OpenRouter model defaults to the cheap Haiku models and lets the API server's
# CORS accept localhost origins.
NODE_ENV=test

# =============================================================================
# DATABASE
# =============================================================================

# Dedicated PostgreSQL database for the test run. It is wiped before and after
# the suite.
# REQUIRED.
# If unset: `e2e/global-setup.ts` throws before connecting; nothing runs.
# Use a database name you can afford to lose — never your development database.
TEST_POSTGRES_URL="postgresql://user:password@localhost:5432/turboplan_test"

# =============================================================================
# AUTHENTICATION
# =============================================================================
# Generate each with `openssl rand -base64 32`. Any value works for tests, but
# generate four DIFFERENT values — reusing one defeats the per-surface split.
# start-servers.sh exports all four to both the web app and the API server, so
# they always match.

# NextAuth session cookie (JWE) and the analytics email HMAC seed.
# REQUIRED (also enforced by e2e/check-env.sh in CI).
# If unset: the web app, API server and landing page all throw "Missing
# `AUTH_SECRET` env variable" at startup and start-servers.sh times out.
AUTH_SECRET=your-auth-secret-here-min-32-chars

# Shared secret on the internal magic-link email endpoint (X-Internal-Secret).
# REQUIRED (also enforced by e2e/check-env.sh in CI).
# If unset: the web app and API server throw at startup. If mismatched between
# them, every login/registration/invite spec fails with a 401 on the email call.
INTERNAL_API_SECRET=your-internal-api-secret-here-min-32-chars

# AES-256-GCM key for secrets stored at rest. API server only.
# REQUIRED (also enforced by e2e/check-env.sh in CI).
# If unset: the API server throws "Missing `ENCRYPTION_KEY` env variable" at
# startup and never comes up.
ENCRYPTION_KEY=your-encryption-key-here-min-32-chars

# HS256 key for API tokens. The specs mint tokens directly with createToken().
# REQUIRED (also enforced by e2e/check-env.sh in CI).
# If unset: the API server and web app throw at startup, and every API-only spec
# throws "JWT_SIGNING_SECRET environment variable is not set" when it mints a
# token.
JWT_SIGNING_SECRET=your-jwt-signing-secret-here-min-32-chars

# =============================================================================
# FILE STORAGE (Cloudflare R2)
# =============================================================================
# Validated together by getR2Env(), lazily on first storage call. Servers boot
# without them, but upload / document / cover-image specs fail with "Missing
# `R2_...` env variable". e2e/check-env.sh requires all five in CI.

# R2 access key ID (S3-compatible credential).
# REQUIRED for upload and document specs; other specs pass without it.
# Create at: Cloudflare Dashboard -> R2 -> Manage R2 API Tokens.
R2_ACCESS_KEY_ID=your-r2-access-key-id

# R2 secret access key.
# REQUIRED for upload and document specs.
# If wrong: R2 returns a 403 signature error mid-test.
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Bucket objects are written to. Use a throwaway bucket — tests write to it.
# REQUIRED for upload and document specs.
R2_BUCKET_NAME=your-bucket-name

# Cloudflare account ID that owns the bucket; it forms the S3 endpoint host.
# REQUIRED for upload and document specs.
R2_ACCOUNT_ID=your-cloudflare-account-id

# Public base URL of the bucket.
# REQUIRED for upload and document specs.
# If wrong: files upload but the web app's next/image allowlist rejects them and
# image assertions fail.
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# =============================================================================
# AI PROVIDERS
# =============================================================================

# OpenRouter API key.
# REQUIRED for any spec that exercises chat, titles or cover-image generation
# (also enforced by e2e/check-env.sh in CI).
# If unset: the servers boot, but the first AI call throws "Missing
# `OPENROUTER_API_KEY` env variable" and that spec fails.
# Get it from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-key-here

# Optional model overrides, one per model slot. Leave commented out.
# OPTIONAL — with NODE_ENV=test the defaults are already the cheap ones
# (anthropic/claude-haiku-4.5 for both text slots, google/gemini-2.5-flash-image
# for both image slots). Uncomment only to pin a specific model.
# OPENROUTER_MODEL_PRIMARY=
# OPENROUTER_MODEL_LITE=
# OPENROUTER_MODEL_IMAGE_PRIMARY=
# OPENROUTER_MODEL_IMAGE_LITE=

# =============================================================================
# APPLICATION URLS
# =============================================================================

# API server URL the web app and landing page are built against.
# REQUIRED (also enforced by e2e/check-env.sh in CI).
# If unset: the web app and landing page throw "Missing `NEXT_PUBLIC_SERVER_URL`
# env variable" and never start.
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# Web app URL.
# REQUIRED (also enforced by e2e/check-env.sh in CI).
# If unset: the landing page throws "Missing `NEXT_PUBLIC_TURBOPLAN_URL` env
# variable"; the shared env loader throws unless TURBOPLAN_URL is set too.
NEXT_PUBLIC_TURBOPLAN_URL=http://localhost:3000

# Landing page URL used by the apps (catalog links, checkout cancel redirect).
# OPTIONAL.
# If unset: LANDING_URL resolves to "" and those links render as broken URLs.
NEXT_PUBLIC_LANDING_URL=http://localhost:3002

# LinkedIn URL. Validated by the landing page's env loader but not currently
# rendered by any page — it still has to be set.
# REQUIRED — the landing page has no fallback.
# If unset: the landing page's root layout throws "Missing
# `NEXT_PUBLIC_LINKEDIN_URL` env variable" at build/prerender time, so
# start-servers.sh times out waiting on port 3002. Any valid URL works.
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com

# Web app URL for the server-side env loader and for the Playwright baseURL /
# page objects.
# OPTIONAL — every consumer falls back to the literal http://localhost:3000.
# If unset: tests still run against port 3000; only matters if you moved the app.
TURBOPLAN_URL=http://localhost:3000

# API server URL used by the API specs' own fetch calls (the apps read
# NEXT_PUBLIC_SERVER_URL instead).
# OPTIONAL — the specs fall back to the literal http://localhost:3001.
SERVER_URL=http://localhost:3001

# Landing page URL used by the landing page objects and the public-catalog spec.
# OPTIONAL — those two consumers fall back to the literal http://localhost:3002.
# Note: this name is used ONLY inside e2e/; the apps use NEXT_PUBLIC_LANDING_URL.
LANDING_PAGE_URL=http://localhost:3002

# =============================================================================
# CORS
# =============================================================================

# Origins the API server accepts browser requests from.
# REQUIRED.
# If unset: the API server throws "Missing `ALLOWED_ORIGINS` env variable" at
# startup and start-servers.sh times out waiting on /health.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Only the literal string "true" (any case) enables a module. Five of these are
# presence-checked by the shared env loader — they must be set to something,
# even "false", or the apps refuse to start; the rest simply default to off.
# start-servers.sh exports these to all three servers, so web and API agree.

# Tasks and milestones module.
# REQUIRED to be present (also enforced by e2e/check-env.sh in CI).
# If unset: the apps throw "Missing `IS_TASKS_PACKAGE_ENABLED` or
# `NEXT_PUBLIC_IS_TASKS_PACKAGE_ENABLED` env variable" at startup.
NEXT_PUBLIC_IS_TASKS_PACKAGE_ENABLED=true

# Custom project fields module.
# OPTIONAL for startup, but e2e/check-env.sh requires it in CI.
# If unset: the fields specs fail because the UI never renders custom fields.
NEXT_PUBLIC_IS_FIELDS_PACKAGE_ENABLED=true

# Interactive maps module.
# REQUIRED to be present (also enforced by e2e/check-env.sh in CI).
# If unset: the apps throw "Missing `IS_MAPS_PACKAGE_ENABLED` or
# `NEXT_PUBLIC_IS_MAPS_PACKAGE_ENABLED` env variable" at startup.
# Left "true" here, which is why MAP_SERVICE_* below must be set.
NEXT_PUBLIC_IS_MAPS_PACKAGE_ENABLED=true

# Project document uploads module.
# OPTIONAL for startup, but e2e/check-env.sh requires it in CI.
# If unset: the document-upload specs fail because the UI hides the feature.
NEXT_PUBLIC_IS_DOCUMENTS_PACKAGE_ENABLED=true

# Project timeline / activity log module.
# OPTIONAL for startup, but e2e/check-env.sh requires it in CI.
# If unset: timeline assertions fail because no activity is recorded.
NEXT_PUBLIC_IS_TIMELINE_RECORDS_PACKAGE_ENABLED=true

# Project context module.
# REQUIRED to be present (value "true" or "false").
# If unset: the apps throw "Missing `IS_PROJECT_CONTEXT_PACKAGE_ENABLED` or the
# NEXT_PUBLIC_ variant" at startup.
NEXT_PUBLIC_IS_PROJECT_CONTEXT_PACKAGE_ENABLED=false

# Research agent integration module (client half).
# REQUIRED to be present (value "true" or "false").
# If unset: the apps throw "Missing
# `IS_RESEARCH_AGENT_INTEGRATION_PACKAGE_ENABLED` or the NEXT_PUBLIC_ variant".
# Enabled here so the research-agent-documents specs run; they self-skip when it
# is off. No live agent on :3003 is needed — the preview endpoint resolves and
# uploads directly — but the RESEARCH_AGENT_SERVICE_* pair below must be set for
# the API server to boot.
NEXT_PUBLIC_IS_RESEARCH_AGENT_INTEGRATION_PACKAGE_ENABLED=true

# Research agent integration module (server half). Must agree with the
# NEXT_PUBLIC_ line above.
# REQUIRED to be present (value "true" or "false").
# If the two disagree: the module counts as ENABLED (either name being "true"
# turns it on), so the API server then demands the RESEARCH_AGENT_SERVICE_* pair.
IS_RESEARCH_AGENT_INTEGRATION_PACKAGE_ENABLED=true

# Research agent service endpoint + key. REQUIRED once the module above is on,
# or the API server throws "Missing `RESEARCH_AGENT_SERVICE_URL` env variable"
# at startup and start-servers.sh times out.
# The e2e research-agent specs do NOT call this service, so placeholders are
# fine — the URL only has to satisfy env validation. Point it at a real agent
# only if you add tests that drive an actual run.
RESEARCH_AGENT_SERVICE_URL=https://localhost:3003
RESEARCH_AGENT_SERVICE_API_KEY=test-research-agent-key-for-e2e

# =============================================================================
# MAP SERVICE
# =============================================================================
# Required because NEXT_PUBLIC_IS_MAPS_PACKAGE_ENABLED=true above.

# Shared secret the API server sends to the Python map service as `X-API-Key`.
# REQUIRED while maps are enabled.
# If unset: the API server throws "Missing `MAP_SERVICE_API_KEY` env variable"
# at startup, so no test runs at all.
# Generate using: openssl rand -base64 32 — must match the map service's value.
MAP_SERVICE_API_KEY=change-me

# Base URL of the Python map service.
# REQUIRED while maps are enabled.
# If unset: the API server throws "Missing `MAP_SERVICE_URL` env variable".
# Note: start-servers.sh does NOT start the map service — GIS-upload specs need
# it running separately (`make run` in packages/services/turboplan-map-server).
MAP_SERVICE_URL=http://localhost:9000

# =============================================================================
# SERVICE AUTHENTICATION
# =============================================================================

# Universal API key for the webhook routes the route-auth specs exercise.
# REQUIRED.
# If unset: the API server throws "Missing `SERVER_API_KEY` env variable" at
# startup. Any value works — the specs only assert 401 on a missing header.
SERVER_API_KEY=test-api-key-for-e2e-tests

# =============================================================================
# BRANDING
# =============================================================================

# Application display name for the server-side surfaces (email subjects).
# OPTIONAL.
# If unset: falls back to the literal "[Your Brand]", which fails any spec
# asserting on the product name.
APP_NAME=TurboPlan

# Application display name for the browser-side surfaces (titles, wordmark).
# OPTIONAL.
# If unset: falls back to the literal "[Your Brand]".
# Keep identical to APP_NAME above.
NEXT_PUBLIC_APP_NAME=TurboPlan

# =============================================================================
# BILLING (Stripe)
# =============================================================================
# Keep the web build and the Hono server in agreement. Without a Stripe TEST key
# the API server cannot boot with billing on, so both sides stay OFF and
# /setup/plan bounces straight through — the billing specs then self-skip with
# "Billing package disabled — skipping."
# To exercise billing locally: set both to true and add STRIPE_SECRET_KEY
# (sk_test_/rk_test_) and STRIPE_WEBHOOK_SECRET.

# Stripe billing module (server half).
# OPTIONAL — defaults to off when absent.
# If "true" without STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET: the API server
# throws at startup and the whole suite fails to launch.
IS_BILLING_PACKAGE_ENABLED=false

# Stripe billing module (client half). Must agree with the line above.
# OPTIONAL — defaults to off when absent.
# If it is "true" while the server half is "false": the UI shows a plan step the
# API refuses to serve, and the billing specs fail instead of skipping.
NEXT_PUBLIC_IS_BILLING_PACKAGE_ENABLED=false

# =============================================================================
# OPTIONAL — TEST USERS, EMAIL, DEBUGGING
# =============================================================================

# Base address for generated test users. A unique `-<timestamp>-<random>` suffix
# is always inserted before the "@".
# OPTIONAL.
# If unset: addresses are generated as test-<timestamp>-<random>@example.com.
# (Magic-link auth — no password is ever needed.)
# TEST_USER_EMAIL=test@example.com

# Ethereal SMTP credentials — give the suite a real inbox to read invitation and
# magic-link emails from at https://ethereal.email/messages.
# OPTIONAL, but BOTH must be set or neither counts.
# If unset: the server falls back to the silent no-op mail provider (nothing is
# sent, no error), and every spec that reads an email skips itself. The
# "auto-created temporary account" only happens once Ethereal is already the
# selected provider, which requires both values below.
# Create an account at: https://ethereal.email/create
# ETHEREAL_USER=
# ETHEREAL_PASS=

# Skip the database wipe before and after the run — useful for inspecting data
# after a failure.
# OPTIONAL — only the exact values "true" or "1" skip the wipe.
# If unset: the schema is dropped and recreated both before and after the suite.
# E2E_SKIP_DB_CLEAR=true
